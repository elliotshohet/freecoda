# Website / API. Never put real credentials in this tracked file.
DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:3010
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AD_SIGNING_SECRET=
# At least 32 random characters; Vercel Cron sends this as a Bearer token.
CRON_SECRET=
# Hosted AI stays closed until evaluation, privacy review, and budget setup pass.
HOSTED_INFERENCE_ENABLED=false
OPENAI_API_KEY=
# Gateway request authentication is separate from provider BYOK credentials.
AI_GATEWAY_API_KEY=
# Vercel supplies VERCEL_OIDC_TOKEN in hosted deployments.
NEXT_TELEMETRY_DISABLED=1
# Cloud workspace beta. Keep disabled until Sandbox and Workflow smoke checks pass.
CLOUD_WORKSPACES_ENABLED=false
# Base64 encoded 32 random bytes; server-only encryption for stored source/chat.
CLOUD_ENCRYPTION_KEY=
# At least 32 random characters; separate preview ticket signing key.
CLOUD_PREVIEW_SECRET=
# Separate GitHub App; OAuth above continues to handle account sign-in.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Immutable GitHub account IDs allowed to view /admin; empty denies every account.
ADMIN_GITHUB_IDS=
